# Optional Telegram control/notifications.
TELEGRAM_ENABLED=true
TELEGRAM_BOT_TOKEN=PASTE_TOKEN_FROM_BOTFATHER
TELEGRAM_ALLOWED_USER_ID=0

# T4Bot private control API.
# Keep the API on loopback and publish it only through an HTTPS reverse proxy
# or private tunnel. Use a long random bearer token (24+ characters).
CONTROL_API_ENABLED=false
CONTROL_API_HOST=127.0.0.1
CONTROL_API_PORT=7099
CONTROL_API_TOKEN=CHANGE_TO_A_LONG_RANDOM_SECRET

# Optional APNs provider for notifications while T4Bot is backgrounded/closed.
# Use an Apple Push Notification Auth Key (.p8). Keep the key outside the repo.

# MT5/Wine bootstrap.
MT5_TERMINAL_PATH=C:\\Program Files\\MetaTrader 5\\terminal64.exe
APP_MODE=DEMO

# Runtime execution settings. Trading preferences are stored account-scoped
# in storage/bot.db, not in .env.
SPREAD_SAMPLE_SIZE=60
MAX_SPREAD_MULTIPLIER=1.8
MAX_SPREAD_POINTS=0
MAX_SLIPPAGE_POINTS=10
MAX_TICK_AGE_SECONDS=15
MIN_SL_POINTS=10
POLL_INTERVAL_MS=150
DB_PATH=storage/bot.db
