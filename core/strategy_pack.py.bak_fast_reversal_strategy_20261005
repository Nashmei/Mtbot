# 26. QIMA chart-pattern breakout/retest (gold + FX)
# Source model: a pattern is actionable only after a real breakout; use
# confirmation/retest, a structural protective stop, and measured-move target.
# =====================================================================
class QIMAChartPatternBreakout(BaseStrategy):
    spec = StrategySpec(
        id='qima_chart_pattern_breakout',
        name='QIMA confirmed chart-pattern breakout/retest',
        family='breakout',
        timeframes=('M15', 'M5'),
        symbols=('XAUUSD', 'EURUSD', 'GBPUSD', 'USDJPY', 'AUDUSD', 'USDCAD', 'NZDUSD'),
        regimes=('BREAKOUT', 'RANGE', 'TREND'),
        forbidden=('VOLATILE', 'NO_TRADE'),
        indicators=('M15 horizontal structure', 'M5 breakout + retest', 'ATR14 M5'),
        tier='B',
        min_confidence=66.0,
        notes='Implements QIMA completion rule: no pattern signal before confirmed breakout.',
    )

    def analyze(self, ctx):
        m15, m5 = ctx.frame('M15'), ctx.frame('M5')
        if len(m15) < 70 or len(m5) < 70:
            return self.wait(ctx, 'INSUFFICIENT_HISTORY', 'Need M15/M5 pattern history')
        ok, reason = self.base_gates(ctx, 'M5', 14, max_spread_atr_frac=0.22)
        if not ok:
            return self.wait(ctx, reason, 'Volatility/spread gate')
        atr_v = _at(ctx.atr('M5', 14))
        swings = ta.swing_points(m15[-70:], 2, 2)
        highs = [x for x in swings if x['type'] == 'HIGH'][-5:]
        lows = [x for x in swings if x['type'] == 'LOW'][-5:]
        if len(highs) < 2 or len(lows) < 2:
            return self.wait(ctx, 'NO_PATTERN', 'Not enough confirmed swing structure')
        resistance = max(x['price'] for x in highs[-3:])
        support = min(x['price'] for x in lows[-3:])
        height = resistance - support
        if height <= atr_v * 0.8 or height > atr_v * 8.0:
            return self.wait(ctx, 'PATTERN_GEOMETRY', 'Pattern height outside usable range')
        tol = max(atr_v * 0.35, ctx.spread * 3.0)
        high_touches = sum(abs(x['price'] - resistance) <= tol for x in highs)
        low_touches = sum(abs(x['price'] - support) <= tol for x in lows)
        if high_touches < 2 and low_touches < 2:
            return self.wait(ctx, 'NO_PATTERN', 'No repeated support/resistance boundary')

        recent = [ta.candle(r) for r in m5[-6:-1]]
        last = ta.candle(m5[-1])
        broke_up = any(r['close'] > resistance for r in recent)
        broke_dn = any(r['close'] < support for r in recent)
        retest_up = broke_up and last['low'] <= resistance + atr_v * 0.20 and last['close'] > resistance and last['bull']
        retest_dn = broke_dn and last['high'] >= support - atr_v * 0.20 and last['close'] < support and last['bear']
        if not (retest_up or retest_dn):
            return self.wait(ctx, 'WAIT_CONFIRMED_BREAK_RETEST', 'Pattern is incomplete until breakout and confirmed retest')
        side = Side.BUY if retest_up else Side.SELL
        level = resistance if side == Side.BUY else support
        price = ctx.price_for(side)
        if abs(price - level) > atr_v * 0.9:
            return self.wait(ctx, 'LATE_ENTRY', 'Breakout retest already extended')
        anchor = support if side == Side.BUY else resistance
        # Protective stop sits back through the broken boundary/retest structure,
        # while the maximum-risk guard prevents oversized pattern stops.
        local_anchor = min(r['low'] for r in recent[-3:] + [last]) if side == Side.BUY else max(r['high'] for r in recent[-3:] + [last])
        stop_info = structural_stop(ctx, side, price, local_anchor, buffer_points=5.0,
                                    min_atr_frac=0.12, atr_frame='M5', max_atr_mult=1.8)
        if not stop_info:
            return self.wait(ctx, 'STOP_TOO_WIDE', 'Protective stop exceeds volatility budget')
        stop, risk = stop_info
        measured = price + height if side == Side.BUY else price - height
        fallback = atr_target(ctx, side, price, risk, atr_mult=1.8, floor_r=1.5, atr_frame='M5')
        target = measured if rr_of(price, stop, measured) >= 1.4 else fallback
        rr = rr_of(price, stop, target)
        if rr < 1.4:
            return self.wait(ctx, 'RR_TOO_LOW', f'Pattern target only {rr:.2f}R')
