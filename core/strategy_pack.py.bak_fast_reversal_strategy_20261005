class HADojiBoxContinuation(BaseStrategy):
    spec = StrategySpec(id='ha_doji_box_continuation', name='Heikin-Ashi H1 Doji Box Continuation', family='trend', timeframes=('H1','M5'), symbols=('XAUUSD',), regimes=('TREND','BREAKOUT','RANGE','VOLATILE','NO_TRADE'), forbidden=(), indicators=('H1 Heikin-Ashi','M5 long-wick doji','two-close box confirmation'), tier='B', min_confidence=66.0)
    @staticmethod
    def _ha(rows):
        out=[]; po=pc=None
        for r in rows:
            o,h,l,c=map(float,(r['open'],r['high'],r['low'],r['close'])); hc=(o+h+l+c)/4; ho=(o+c)/2 if po is None else (po+pc)/2
            out.append({'open':ho,'close':hc}); po,pc=ho,hc
        return out
    def analyze(self,ctx):
        h1,m5=ctx.frame('H1'),ctx.frame('M5')
        if len(h1)<30 or len(m5)<40:return self.wait(ctx,'INSUFFICIENT_HISTORY','Need H1/M5 history')
        ok,reason=self.base_gates(ctx,'M5',14,max_spread_atr_frac=.22)
        if not ok:return self.wait(ctx,reason,'Gold volatility/spread gate')
        ha=self._ha(h1[-30:]); r=ha[-3:]; bull=sum(x['close']>x['open'] for x in r); bear=sum(x['close']<x['open'] for x in r)
        if bull>=2 and r[-1]['close']>r[-2]['close']:side=Side.BUY
        elif bear>=2 and r[-1]['close']<r[-2]['close']:side=Side.SELL
        else:return self.wait(ctx,'HA_H1_NO_TREND','H1 Heikin-Ashi direction is not clean')
        bars=[ta.candle(x) for x in m5]; d,b1,b2=bars[-3],bars[-2],bars[-1]
        if d['body_ratio']>.28:return self.wait(ctx,'NO_LONG_WICK_DOJI','M5 anchor body is too large')
        wick=max(d['upper_wick'],d['lower_wick'])
        if wick<max(d['body']*2,d['range']*.45):return self.wait(ctx,'DOJI_WICK_TOO_SHORT','M5 anchor needs a long rejection wick')
        look=bars[-8:-2]
        if side==Side.BUY:
            if d['lower_wick']<d['upper_wick']:return self.wait(ctx,'WRONG_DOJI_WICK','BUY needs lower rejection wick')
            lo=min(x['low'] for x in look+[d]); hi=max(d['open'],d['close'])
            if not(b1['close']>hi and b1['bull']):return self.wait(ctx,'WAIT_BOX_BREAK','First close not above box')
            if not(b2['close']>hi and b2['close']>=b1['open']):return self.wait(ctx,'WAIT_BOX_CONFIRM','Second close not confirmed')
        else:
            if d['upper_wick']<d['lower_wick']:return self.wait(ctx,'WRONG_DOJI_WICK','SELL needs upper rejection wick')
            hi=max(x['high'] for x in look+[d]); lo=min(d['open'],d['close'])
            if not(b1['close']<lo and b1['bear']):return self.wait(ctx,'WAIT_BOX_BREAK','First close not below box')
            if not(b2['close']<lo and b2['close']<=b1['open']):return self.wait(ctx,'WAIT_BOX_CONFIRM','Second close not confirmed')
        height=hi-lo
        if height<=0:return self.wait(ctx,'INVALID_BOX','Invalid correction box')
        price=ctx.price_for(side); stop=(lo+hi)/2
        if abs(price-stop)<=ctx.spread*2:return self.wait(ctx,'BOX_STOP_TOO_TIGHT','Mid-box stop inside noise')
        target=price+height*2.5 if side==Side.BUY else price-height*2.5
        conf=confidence_score(68,min(8,wick/max(d['body'],ctx.point)/3))
        return signal_decision(self.spec,ctx,side,price,stop,target,conf,'H1 HA trend + M5 doji box + two-close confirmation',management={'protection_pct':35.0,'trailing_trigger_pct':60.0,'trailing_gap_pct':8.0,'max_hold_minutes':240},draw=self.chart(ctx,zones=[{'kind':'HA_DOJI_BOX','low':lo,'high':hi}],levels=[{'type':'ENTRY','price':price},{'type':'SL','price':stop},{'type':'TP','price':target}]),regime=ctx.regime.value)


