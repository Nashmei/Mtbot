                                                        atr_frame='M5', max_atr_mult=1.8)
                            if stop_info:
                                stop, risk = stop_info
                                target = neckline - (max(a['price'], b['price']) - neckline) * 0.8
                                rr = rr_of(price, stop, target)
                                if rr >= 1.2:
