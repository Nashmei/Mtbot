class QIMANR4Breakout(BaseStrategy):
    spec = StrategySpec(
        id='qima_nr4_breakout',
        name='QIMA NR4 narrow-range breakout',
        family='breakout',
        timeframes=('M15', 'M5'),
        symbols=('XAUUSD', 'EURUSD', 'GBPUSD', 'USDJPY', 'AUDUSD', 'USDCAD', 'NZDUSD'),
        regimes=('TREND',),
        forbidden=('BREAKOUT', 'RANGE', 'VOLATILE', 'NO_TRADE'),
        indicators=('M5 NR4', 'M5 breakout close', 'M15 EMA21 bias', 'ATR14 M5'),
        tier='B',
        min_confidence=66.0,
    )

    def analyze(self, ctx):
        m15, m5 = ctx.frame('M15'), ctx.frame('M5')
        if len(m15) < 40 or len(m5) < 60:
            return self.wait(ctx, 'INSUFFICIENT_HISTORY', 'Need M15/M5 history')
        ok, reason = self.base_gates(ctx, 'M5', 14, max_spread_atr_frac=0.20)
        if not ok:
            return self.wait(ctx, reason, 'Volatility/spread gate')
        bars = [ta.candle(r) for r in m5[-5:]]
        setup = bars[-2]
        prior = bars[-5:-2]
        if not all(setup['range'] < r['range'] for r in prior):
            return self.wait(ctx, 'NO_NR4', 'Setup bar is not narrower than previous three bars')
        last = bars[-1]
        up = last['close'] > setup['high'] and last['bull']
        dn = last['close'] < setup['low'] and last['bear']
        if not (up or dn):
            return self.wait(ctx, 'WAIT_NR4_BREAK', 'NR4 formed; waiting for high/low breakout')
        side = Side.BUY if up else Side.SELL
        c15 = ta.closes(m15); ema21 = ta.ema(c15, 21)
        if _at(ema21) is not None:
            if side == Side.BUY and c15[-1] < ema21[-1]:
                return self.wait(ctx, 'M15_BIAS_BLOCK', 'NR4 buy break against M15 bias')
            if side == Side.SELL and c15[-1] > ema21[-1]:
                return self.wait(ctx, 'M15_BIAS_BLOCK', 'NR4 sell break against M15 bias')
        atr_v = _at(ctx.atr('M5', 14)); price = ctx.price_for(side)
        if abs(price - (setup['high'] if side == Side.BUY else setup['low'])) > atr_v * 0.75:
            return self.wait(ctx, 'LATE_ENTRY', 'NR4 breakout already extended')
        anchor = setup['low'] if side == Side.BUY else setup['high']
        stop_info = structural_stop(ctx, side, price, anchor, buffer_points=4.0,
                                    min_atr_frac=0.10, atr_frame='M5', max_atr_mult=1.5)
        if not stop_info:
            return self.wait(ctx, 'STOP_TOO_WIDE', 'NR4 protective stop exceeds budget')
        stop, risk = stop_info
        target = atr_target(ctx, side, price, risk, atr_mult=1.7, floor_r=1.5, atr_frame='M5')
        conf = confidence_score(67, min(6, last['body_ratio'] * 6))
        return signal_decision(
            self.spec, ctx, side, price, stop, target, conf,
            'QIMA NR4 confirmed by a close beyond the narrow-range high/low',
            management={'protection_pct': 35.0, 'trailing_trigger_pct': 58.0, 'trailing_gap_pct': 8.0,
                        'max_hold_minutes': 180},
            draw=self.chart(ctx, zones=[{'kind': 'NR4', 'low': setup['low'], 'high': setup['high']}],
                            levels=[{'type': 'ENTRY', 'price': price}, {'type': 'SL', 'price': stop},
                                    {'type': 'TP', 'price': target}]),
            regime=ctx.regime.value,
        )


